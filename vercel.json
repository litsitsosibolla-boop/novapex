      "source": "/(01-finance-exec|02-artist-manager|03-boutique-retail|04-lodge-tourism|05-law-firm|06-fitness-studio|07-food-agro|08-private-college|09-real-estate|10-ngo-civic|2026-model|targets|quote)/:path*",
